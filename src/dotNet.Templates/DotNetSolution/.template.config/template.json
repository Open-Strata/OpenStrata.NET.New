{
  "$schema": "http://json.schemastore.org/template",
  "author": "OpenStrata",
  "classifications": [ "Common", "OpenStrata", "Dataverse", "Power Platform" ],
  "identity": "OpenStrata.NET.DotNetSolution",
  "name": "OpenStrata .Net MSBuild Solution Template",
  "shortName": "os-dotnet",
  "sourceName": "OstrataTemplate.1",
  "primaryOutputs": [
    {
      "path": "OstrataTemplate.1.sln"
    }
  ],
  "symbols": {"ostrata-version":{"type": "parameter", "datatype":"text", "defaultValue": "1.*", "replaces": "ostrataVersion.1" },
              "publisher-name":{"type": "parameter", "datatype":"text", "defaultValue": "", "isRequired":true,
                                "description":"Name of the Dataverse solution publisher", "replaces": "publishername.1"},
              "publisher-prefix": {"type": "parameter", "datatype":"text", "defaultValue": "", "isRequired":true,
                                  "description": "Customization prefix value for the Dataverse solution publisher" ,  "replaces": "publisherPrefix.1"},
              "noext": {"type": "parameter", "datatype":"bool", "defaultValue": "false",
                                  "description": "Indicates whether to prompt to add additional extensions" }},
  "guids": [
    "62B8C8AF-2900-4FF8-9F43-3C688FECD2F6",
    "9F9B27DE-E80A-45D2-8409-68DBA02DF81E",
    "636A203C-3C3C-4118-B510-95885C82F18B",
    "EF71EDF5-5739-493A-B2A2-A21E91543F8F",
    "D5888FF2-8A96-4BF0-B507-A9F17F6AD8AC",

    "1283968e-b332-4d7b-9cd9-2ab634f592e6",
    "fa333426-d583-4ff2-9ebb-088c0117960a",
    "14d4a3d8-9a19-4f3d-b317-ebf34f0d3fdd",
    "57e84a66-260c-4993-bbdc-7b4561c29378"
  ],
  "postActions": [
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "new install OpenStrata.Devops.VSCode.New",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      },
      "manualInstructions": [{
         "text": "Run 'dotnet new install OpenStrata.Devops.VSCode.New'"
      }],
      "continueOnError": true,
      "description ": "Installing templates for OpenStrata VSCode Extensions",
      "condition": "noext == false"
    },    
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "new os-vscode",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      },
      "manualInstructions": [{
         "text": "Run 'dotnet new os-vscode'"
      }],
      "continueOnError": true,
      "description ": "Adding VSCode Extension Files",
      "condition": "noext == false"
    },
    {
      "condition": "noext == false",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [{
        "text": "Run 'dotnet restore'"
      }],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }


  ]
}
