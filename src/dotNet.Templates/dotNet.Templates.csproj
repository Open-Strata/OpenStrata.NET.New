<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>netstandard2.0</TargetFramework>
	  <PackageType>Template</PackageType>

	  <OpenStrata>OpenStrata</OpenStrata>
	  <AssemblyNamePrefix Condition="'$(DerivativeNamePrefix)'!=''">$(DerivativeNamePrefix).$(OpenStrata)</AssemblyNamePrefix>
	  <AssemblyNamePrefix Condition="'$(DerivativeNamePrefix)'==''">$(OpenStrata)</AssemblyNamePrefix>
	  <RootNamespacePrefix Condition="'$(DerivativeNamePrefix)'!=''">$(DerivativeNamePrefix).$(OpenStrata)</RootNamespacePrefix>
	  <RootNamespacePrefix Condition="'$(DerivativeNamePrefix)'==''">$(OpenStrata)</RootNamespacePrefix>

	  <AssemblyName>$(AssemblyNamePrefix).$(MSBuildProjectName)</AssemblyName>
	  <RootNamespace>$(RootNamespacePrefix).$(MSBuildProjectName)</RootNamespace>	  
	 
	  
      <!--<Version>0.1.17</Version>
	  <PackageVersion>$(Version)-Beta</PackageVersion>-->
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <PackageId>$(RootNamespacePrefix).NET.Templates</PackageId>
	  <Title>OpenStrata .NET Project and Item Templates</Title>
	  <Description>Templates to use when creating Power Platform Strata.</Description>
	  <PackageTags>dotnet-new;OpenStrata;PowerPlatform;PowerApps;Dataverse;CDS;CommonDataService;Dynamics365;D365;XRM;CRM;Dynamics</PackageTags>

	  <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	  <IncludeContentInPack>true</IncludeContentInPack>
	  <IncludeBuildOutput>false</IncludeBuildOutput>
	  <ContentTargetFolders>content</ContentTargetFolders>

	  <RemoveItems>**\bin\**;**\.vs\**;**\obj\**;**\*.sln;**\*.snk;**\*.user;Solution\src\**;**\Solution\src\**;**\summary.txt;**\releaseNotes.txt;**\description.txt;**\PkgFolder\**;**\Package\ImportPackage.cs;**\readme.md;**\ConfigData\data\**;**\Solution\metadata\**</RemoveItems>

	  <SignAssembly>false</SignAssembly>
	  <UseGitInfoForVersions>true</UseGitInfoForVersions>
	  <IncludeGitInfoInPackage>true</IncludeGitInfoInPackage>	  
	  
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OpenStrata.MSBuild.Nuget" Version="1.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="GitInfo">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<!--<ItemGroup>
		<PackageReference Include="GitInfo" Version="2.2.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>-->


	<!-- <Import Project="..\..\Shared\PublisherInfo.Shared\PublisherInfo.Shared.projitems" />	 -->
	
	
	<PropertyGroup Label="Nuget Packaging Properties">
		<Authors>OpenStrata Initiative</Authors>
		<Copyright>Copyright (c)</Copyright>
		<Company>Open Strata Initiative</Company>		
		<Product>OpenStrata ALM Tools</Product>
		<!--<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>-->
		<PackageLicenseExpression>APSL-2.0</PackageLicenseExpression>		
		<PackageIcon>ICON.png</PackageIcon>
		<PackageIconUrl />
	</PropertyGroup>	

  <ItemGroup>
	  <Content Include="AppSource\**\*" PackagePath="\content\AppSource\" />
	  <Content Include="Solution\**\*" Exclude="Solution\src\**" PackagePath="\content\Solution\" />
	  <Content Include="Strati\**\*" PackagePath="\content\Strati\" />
	  <Content Include="Publisher.ALM\**\*" PackagePath="\content\Publisher.ALM\" />
	  <Content Include="Package\**\*" PackagePath="\content\Package\" />
	  <Content Include="ConfigData\**\*" PackagePath="\content\ConfigData\" />
	  <Content Include="Deployment\**\*" PackagePath="\content\Deployment\" />
	  <Content Include="Plugin\**\*" PackagePath="\content\Plugin\" />
      <Content Include="Essentials\**\*" Exclude="Essentials\rm.gitignore" PackagePath="\content\Essentials\" />
      <Content Include="OpenStrataProps\**\*" PackagePath="\content\OpenStrataProps\" />
      <Content Include="StrataVersionProps\**\*" PackagePath="\content\StrataVersionProps\" />	  

	  <Content Include="DocumentTemplates\**\*" PackagePath="\content\DocumentTemplates\" />	
	  
	  <Content Include="PCF\**\*" PackagePath="\content\PCF\" />
	  
	  <Content Include="PowerPages\**\*" PackagePath="\content\PowerPages\" />

	  <Content Include="DotNetSolution\**\*" PackagePath="\content\DotNetSolution\" />

      <Content Include="OpenStrataProps\**\*" Exclude="OpenStrataProps\.template.config\*" PackagePath="\content\DotNetSolution\" />
	  <Content Include="Essentials\**\*" Exclude="Essentials\.template.config\*;Essentials\rm.gitignore" PackagePath="\content\DotNetSolution\" />
	  <Content Include="Solution\**\*" Exclude="Solution\.template.config\*" PackagePath="\content\DotNetSolution\" />
	  <Content Include="Strati\**\*" Exclude="Strati\.template.config\*" PackagePath="\content\DotNetSolution\" />
	  <Content Include="Package\**\*" Exclude="Package\.template.config\*" PackagePath="\content\DotNetSolution\" />
	  <Content Include="ConfigData\**\*" Exclude="ConfigData\.template.config\*" PackagePath="\content\DotNetSolution\" />
	  <Content Include="Deployment\**\*" Exclude="Deployment\.template.config\*" PackagePath="\content\DotNetSolution\" />

	  <Compile Remove="**\**" />
	  
	  <Compile Remove="Pipelines\**" />
	  <Content Remove="Archive.DotNetSolution\**" />
	  <Content Remove="Archive.PublisherDotNet\**" />
	  <Content Remove="Archive.Pipelines\**" />	  
	  <None Remove="Archive.DotNetSolution\**" />
	  <None Remove="Archive.PublisherDotNet\**" />
	  <None Remove="Archive.Pipelines\**" />	  
	  <Content Remove="$(RemoveItems)" />
	  <EmbeddedResource Remove="$(RemoveItems)" />
	  <None Remove="$(RemoveItems)" />
	  <None Remove="DotNetSolution\environment.props" />
	  <None Remove="DotNetSolution\global.json" />




      <!--Adding back dotnet solution file-->
	  <Content Include="DotNetSolution\**\*.sln" PackagePath="\content\DotNetSolution\" />


	  <!--Moving this to the end to ensure .gitIgnores are included-->


	  <Content Include="readme.md" PackagePath="\docs\" />
	  
	  
	  <!--.gitignore dotfilename workaround-->
	  
  <!--.gitignore dotfilename workaround-->


	  <Content Include="Essentials\rm.gitignore" PackagePath="\content\DotNetSolution\.gitignore" />
	  <Content Include="Essentials\rm.gitignore" PackagePath="\content\Essentials\.gitignore" />

  </ItemGroup>	

  <ItemGroup>
    <None Update="ICON.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>	



	<Target Name="TemplatesAfterPack" AfterTargets="Pack" DependsOnTargets="MoveNugetPackageToLocalPackageFeed">

		<Exec Command="dotnet new uninstall $(PackageId)" IgnoreExitCode="true" />

		<Warning Text="dotnet new install $(NugetFileAbsolutePath) --force" />
		
		<Exec Command="dotnet new install $(NugetFileAbsolutePath) --force" />
		
	</Target>

</Project>
