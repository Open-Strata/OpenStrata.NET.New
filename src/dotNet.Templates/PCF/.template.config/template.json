{
  "$schema": "http://json.schemastore.org/template",
  "author": "OpenStrata",
  "classifications": [ "Common", "OpenStrata", "Dataverse", "Power Platform" ],
  "identity": "OpenStrata.NET.PCF",
  "name": "OpenStrata PCF Template",
  "shortName": "os-pcf",
  "sourceName": "OstrataTemplate.1",
  "description": "Initializes a PCF subdirectory with a new Power Apps component framework project extended with OpenStrata",
  "primaryOutputs": [
    {
      "path": "PCF/PCFProjectSubFolder/OstrataTemplate.1.pcfproj"
    }
  ],
  "symbols": {"ostrata-version":{"type": "parameter", "datatype":"text", "defaultValue": "1.*", "replaces": "ostrataVersion.1" },
              "namespace":{"type": "parameter", "datatype":"text", "isRequired":true,
                             "description":"The namespace for the component", "replaces": "pcfNameSpace.1" },
              "template":{"type": "parameter", "datatype":"choice", "defaultValue": "field",
                          "description": "Choose a template for the component.",  
                          "choices": [{"choice": "field"},{"choice": "dataset"}], "replaces": "pcfTemplate.1" },
              "framework":{"type": "parameter", "datatype":"choice", "defaultValue": "none", 
                          "description": "The rendering framework for control. The default value is 'none', which means HTML.",
                          "choices": [{"choice": "none"},{"choice": "react"}], "replaces": "pcfFramework.1" },
              "run-npm-install" : {"type":"parameter", "datatype":"bool", "defaultValue": "false",
                                       "description": "Auto run 'npm install' after the control is created. The default value is 'false'."},
              "PCFProjectSubRename": {"type":"generated", "generator": "join", "fileRename": "PCFProjectSubFolder", 
              "parameters": {"symbols": [{"type": "ref", "value": "namespace"},
                                        {"type": "ref","value": "name"}],
                              "separator": ".",
                              "removeEmptyValues": true}},
               "npm-install-args" : {"type": "generated", "generator": "join",
                "parameters": {"symbols": [{"type": "const", "value" : "install PCF/"},
                                           {"type": "ref", "value": "PCFProjectSubRename"},
                                           {"type": "const","value": "/"}]},
                              "separator": ".",
                              "removeEmptyValues": true}},             
   "sources": [{
    "modifiers": [
      {"condition": "template != field", "exclude": ["**/*.field.*"]},
      {"condition": "template != dataset", "exclude": ["**/*.dataset.*"]},
      {"condition": "framework != none", "exclude": ["**/*.none.*"]},
      {"condition": "framework != react", "exclude": ["**/*.react.*"]},
      {"condition": "template == dataset && framework == none", "rename": {"ManifestTypes.d.none.dataset.ts": "ManifestTypes.d.ts",
                                                      "index.none.dataset.ts": "index.ts",
                                                      "ControlManifest.Input.none.dataset.xml": "ControlManifest.Input.xml"}},
      {"condition": "template == field && framework == none", "rename": {"ManifestTypes.d.none.field.ts": "ManifestTypes.d.ts",
                                                      "index.none.field.ts": "index.ts",
                                                      "ControlManifest.Input.none.field.xml": "ControlManifest.Input.xml"}},
      {"condition": "template == field && framework == react", "rename": {"ManifestTypes.d.react.ts": "ManifestTypes.d.ts",
                                                      "index.react.field.ts": "index.ts",
                                                      "ControlManifest.Input.react.field.xml": "ControlManifest.Input.xml"}},
      {"condition": "template == dataset && framework == react", "rename": {"ManifestTypes.d.react.ts": "ManifestTypes.d.ts",
                                                      "index.react.dataset.ts": "index.ts",
                                                      "ControlManifest.Input.react.dataset.xml": "ControlManifest.Input.xml"}},
      {"condition": "framework == none", "rename": {".eslintrc.none.json": ".eslintrc.json",
                                                      "package.none.json": "package.json"}},
      {"condition": "framework == react", "rename": {".eslintrc.react.json": ".eslintrc.json",
                                                      "package.react.json": "package.json",
                                                      "HelloWorld.react.tsx": "HelloWorld.tsx"}}                                                        
    ]}],
  "guids": ["1d2cf6ad-b623-4863-9ef4-916cc1ff105e"],
  "postActions": [
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",      
      "description": "Running NPM Install",
      "manualInstructions": [{"text" : "Run .\\PCF\\PCFProjectSubFolder\\install-npm.ps1"}],
      "args":{"executable": "powershell.exe",
              "args": "-File .\\PCF\\PCFProjectSubFolder\\install-npm.ps1"},
      "applyFileRenamesToArgs": ["args"],
      "applyFileRenamesToManualInstructions": true,
      "continueOnError": true,
      "condition": "run-npm-install == true"
    },
    {
      "description": "Adding to solution.",
      "manualInstructions": [
        { "text": "Adding to solution" }
      ],
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "continueOnError": true,
      "args": {
        "primaryOutputIndexes": "0"
      }
    },
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "args": {
        "primaryOutputIndexes": "0"
      }
    }
  ]
}
