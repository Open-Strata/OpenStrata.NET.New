{
  "$schema": "http://json.schemastore.org/template",
  "author": "OpenStrata",
  "classifications": [ "Common", "OpenStrata", "Dataverse", "Power Platform" ],
  "identity": "OpenStrata.NET.PCF",
  "name": "OpenStrata PCF Template",
  "shortName": "os-pcf",
  "sourceName": "OstrataTemplate.1",
  "primaryOutputs": [
    {
      "path": "PCF/PCFProjectSubFolder/OstrataTemplate.1.pcfproj"
    }
  ],
  "symbols": {"ostrata-version":{"type": "parameter", "datatype":"text", "defaultValue": "1.*", "replaces": "ostrataVersion.1" },
              "name-space":{"type": "parameter", "datatype":"text", "isRequired":true, "replaces": "pcfNameSpace.1" },
              "template":{"type": "parameter", "datatype":"text", "defaultValue": "field", "choices": ["field", "dataset"], "replaces": "pcfTemplate.1" },
              "framework":{"type": "parameter", "datatype":"text", "defaultValue": "none", "choices": ["none", "react"], "replaces": "pcfFramework.1" },
              "PCFProjectSubRename": {"type":"generated", "generator": "join", "fileRename": "PCFProjectSubFolder", 
              "parameters": {"symbols": [{"type": "ref", "value": "name-space"},
                                        {"type": "ref","value": "name"}],
                              "separator": ".",
                              "removeEmptyValues": true}}              
      },
  "guids": ["1d2cf6ad-b623-4863-9ef4-916cc1ff105e"],
