{
  "$schema": "http://json.schemastore.org/template",
  "author": "OpenStrata",
  "classifications": [ "Common", "OpenStrata", "Dataverse", "Power Platform" ],
  "identity": "OpenStrata.NET.Solution",
  "name": "Dataverse Solution Template",
  "shortName": "os-solution",
  "sourceName": "OstrataTemplate.1",
  "primaryOutputs": [
    {
      "path": "Solution\\OstrataTemplate.1.Solution.csproj"
    }
  ],
  "symbols": {"ostrata-version":{"type": "parameter", "datatype":"text", "defaultValue": "1.*", "replaces": "ostrataVersion.1" },
  "publisher-name":{"type": "parameter", "datatype":"text", "defaultValue": "", "isRequired":true, "replaces": "publishername.1"},
  "publisher-prefix": {"type": "parameter", "datatype":"text", "defaultValue": "", "isRequired":true, "replaces": "publisherPrefix.1"}},
  "postActions": [
    {
      "description": "Adding to solution.",
      "manualInstructions": [
        { "text": "Adding to solution" }
      ],
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "continueOnError": true,
      "args": {
        "primaryOutputIndexes": "0"
      }
    },
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "args": {
        "files": [ "Solution\\OstrataTemplate.1.Solution.csproj" ]
      }
    }
  ]
}
