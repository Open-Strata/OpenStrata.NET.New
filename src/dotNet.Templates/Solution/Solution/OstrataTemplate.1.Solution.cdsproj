	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenStrata.MSBuild.Solution" Version="1.*" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="1.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />		


	  <!--Modify the publisher reference as appropriate -->

	  <!--<PackageReference Include="" Version="1.*">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>-->
  
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PCF\**\*.pcfproj" Exclude="@(PcfProjExcludes)" />
		<PluginReference Include="..\Plugin\OstrataTemplate.1.Plugin.csproj" Condition="Exists('..\Plugin\OstrataTemplate.1.Plugin.csproj')"/>
	</ItemGroup>

	<ItemGroup Label="SolutionXmlDependencyCleanup">
		<!--<AttributeDependenciesToRemove Include="[AttributeID]" />-->
