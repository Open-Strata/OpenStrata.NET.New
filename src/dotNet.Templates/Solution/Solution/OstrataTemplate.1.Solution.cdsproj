<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="OpenStrata.Build.NoTargets" xmlns='http://schemas.microsoft.com/developer/msbuild/2003'>

	<PropertyGroup>
		<PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
	</PropertyGroup>

	<!-- <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"  /> -->
	<Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props')" />


	<PropertyGroup>


		<TargetFramework>net472</TargetFramework>
		<NoWarn>MSB3245</NoWarn>

		<ProjectGuid>62B8C8AF-2900-4FF8-9F43-3C688FECD2F6</ProjectGuid>

		<DataverseSolutionName>OstrataTemplate._1</DataverseSolutionName>
		<DataversePublisherUniqueName>publishername.1</DataversePublisherUniqueName>
		<DataversePublisherPrefix>publisherPrefix.1</DataversePublisherPrefix>


		<!--<RemoveActiveDependencies>true</RemoveActiveDependencies>	-->		

		<!-- <IncludeAutoNumbering >true</IncludeAutoNumbering> -->
		<!-- <IncludeCalendar >true</IncludeCalendar> -->
		<!-- <IncludeCustomization >true</IncludeCustomization> -->
